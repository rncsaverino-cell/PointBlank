# ── Supabase ─────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
# Leave these unset (or keep the "your-project" placeholder) to run the app
# in demo mode with realistic mock data and no real accounts — see README.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER expose to the client.
# Settings → API → service_role secret. Used for privileged admin
# operations. Optional; only needed if you extend admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (optional) ───────────────────────────────────────────────────
# Only needed if you want retailers to be able to pay an order by card.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
